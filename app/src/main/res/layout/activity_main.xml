<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0.00 m"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Ubicación: sin datos" />

        <EditText
            android:id="@+id/precision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precisión del movimiento (metros)"
            android:inputType="numberDecimal"
            android:text="1" />

        <EditText
            android:id="@+id/intervalo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tiempo de actualización (segundos)"
            android:inputType="number"
            android:text="1" />

        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar tutoría" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizar y guardar" />

        <Button
            android:id="@+id/btnReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver reporte consolidado" />

        <TextView
            android:id="@+id/reporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>